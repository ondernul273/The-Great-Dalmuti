# ---------------------------------------------------------------
# Optional: dedicated TURN server (STRONGLY recommended for
# corporate networks). Without this the app falls back to the free,
# shared, rate-limited Open Relay project.
#
# Copy this file to `.env` and fill in your own credentials.
# ---------------------------------------------------------------

# Comma separated. Include a TCP and a TLS variant on port 443 —
# that is what gets through corporate firewalls.
# VITE_TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:443?transport=tcp,turns:turn.example.com:5349
# VITE_TURN_USERNAME=my-turn-user
# VITE_TURN_CREDENTIAL=my-turn-password

# ---------------------------------------------------------------
# Banquet Browser (Socket.IO lobby server).
# Start it with:  node server/banquet-server.mjs   (default port 3001)
# If unset, the client falls back to the page origin, which will
# fail unless you deploy the relay next to the app.
# ---------------------------------------------------------------
# VITE_BANQUET_URL=http://localhost:3001

# ---------------------------------------------------------------
# Optional: self-hosted PeerJS signaling server.
# Defaults to the public PeerJS cloud (0.peerjs.com:443, TLS).
# ---------------------------------------------------------------
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
# VITE_PEER_KEY=peerjs
